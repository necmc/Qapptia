<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Qapptia.Launcher</RootNamespace>
    <AssemblyName>Qapptia</AssemblyName>
    <Product>Qapptia</Product>
    <Title>Qapptia</Title>
    <AssemblyTitle>Qapptia</AssemblyTitle>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Qapptia.Core\Qapptia.Core.csproj" />
    <ProjectReference Include="..\Qapptia.UI.Components\Qapptia.UI.Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
