<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Qapptia.App.Capture</RootNamespace>
    <AssemblyName>QapptiaCapture</AssemblyName>
    <Product>Qapptia Capture</Product>
    <Title>Qapptia Capture</Title>
    <AssemblyTitle>Qapptia Capture</AssemblyTitle>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Async" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ProjectReference Include="..\Qapptia.Platform.Windows\Qapptia.Platform.Windows.csproj" />
  </ItemGroup>
  
  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <ProjectReference Include="..\Qapptia.Platform.Linux\Qapptia.Platform.Linux.csproj" />
    <ProjectReference Include="..\Qapptia.Platform.MacOS\Qapptia.Platform.MacOS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Qapptia.Capture\Qapptia.Capture.csproj" />
    <ProjectReference Include="..\Qapptia.UI.Components\Qapptia.UI.Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <None Update="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Qapptia.App.Editor\Assets\tray_icon.png" Link="Assets\tray_icon.png"
          CopyToOutputDirectory="PreserveNewest" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
  </ItemGroup>

</Project>
